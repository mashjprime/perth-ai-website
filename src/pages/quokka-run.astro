---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import site from '../data/site.json';

/* Quokka Run, the game from our DDD Perth 2026 booth, kept for good. The game
   needs client JavaScript (it's a canvas game) and the leaderboard needs the
   API at /api/quokka-run/scores. See docs/quokka-run.md.

   The markup for every screen is here; src/scripts/quokka-run/game.js only
   shows and hides it and fills in the numbers. */
---

<Base
  title="Quokka Run"
  description="A one-tap runner from Perth AI. Dodge hallucinations, GPU fires and rate limits, tell fact from hallucination at every gate, and get on the leaderboard."
>
  <PageHero
    eyebrow="Perth AI arcade"
    title="Quokka Run"
    lead="The game from our DDD Perth 2026 booth. Dodge hallucinations, GPU fires and rate limits, and sort fact from hallucination at every gate. It gets faster every 20 seconds."
  />

  <Section tone="dark">
    <div
      data-quokka-run
      tabindex="-1"
      class="qr-stage relative isolate h-[min(68svh,520px)] min-h-[420px] overflow-hidden rounded-2xl bg-gradient-to-b from-ink-800 to-ink-950 ring-1 ring-white/10 md:aspect-video md:h-auto md:max-h-[80svh] md:min-h-0"
    >
      <img
        src="/perth-skyline.webp"
        alt=""
        aria-hidden="true"
        width="1600"
        height="579"
        class="pointer-events-none absolute inset-x-0 w-full opacity-25"
        style="bottom: var(--ground-px, 0)"
      />
      <canvas data-canvas class="absolute inset-0 h-full w-full"></canvas>

      {/* While running. The HUD is for sighted players; the result is announced at the end. */}
      <div
        data-hud
        hidden
        aria-hidden="true"
        class="pointer-events-none absolute right-4 top-3 z-10 flex items-center gap-4 font-display text-sm font-bold text-white sm:text-base"
      >
        <span data-hud-level>Lv 1</span>
        <span data-hud-tokens>🪙 0</span>
        <span data-hud-gates>🧠 0/0</span>
        <span data-hud-score class="min-w-[4ch] text-right text-2xl tabular-nums text-sunset-500">0</span>
      </div>

      <div
        data-gate-card
        hidden
        aria-live="polite"
        class="pointer-events-none absolute inset-x-3 top-14 z-10 mx-auto max-w-3xl rounded-2xl bg-white px-5 py-4 text-center text-ink-900 shadow-[0_8px_0_rgb(0_0_0/0.35)] sm:px-8 sm:py-5"
      >
        <p data-gate-meta class="text-xs font-bold uppercase tracking-[0.12em] text-ink-600"></p>
        <p data-gate-text class="mt-1 font-display text-base font-semibold text-balance sm:text-xl"></p>
        <p data-gate-how class="mt-2 flex flex-wrap justify-center gap-x-6 gap-y-1 text-sm font-bold">
          <span class="text-azure-700">↑ Jump = FACT</span>
          <span class="text-coral-700">→ Run under = HALLUCINATION</span>
        </p>
      </div>

      {/* Start screen, over the game playing itself */}
      <div
        data-start-screen
        class="absolute inset-0 z-20 flex flex-col items-center justify-center gap-5 bg-ink-950/55 p-6 text-center"
      >
        <p class="max-w-sm text-lg font-semibold text-white">Tap, click or press Space to jump.</p>
        <p class="hidden text-sm font-semibold text-azure-300 max-sm:portrait:block">
          Turn your phone sideways to see further ahead.
        </p>
        <button
          type="button"
          data-play
          class="rounded-xl bg-sunset-500 px-8 py-4 font-display text-xl font-semibold text-ink-950 transition-colors hover:bg-sunset-600"
        >
          Start running
        </button>
      </div>

      {/* Results */}
      <div data-results hidden class="absolute inset-0 z-20 overflow-y-auto bg-ink-950/85 backdrop-blur-sm">
        <div class="mx-auto flex min-h-full max-w-md flex-col justify-center p-6">
          <h2
            data-results-heading
            tabindex="-1"
            class="text-sm font-semibold uppercase tracking-[0.14em] text-azure-300 focus:outline-none"
          >
            <span data-cause>Game over</span>
            <span class="sr-only">. You scored</span>
            <span data-final class="mt-2 block font-display text-6xl normal-case tracking-tight text-sunset-500 tabular-nums">0</span>
          </h2>
          <p data-summary class="mt-3 text-ink-200"></p>

          <form data-save novalidate class="mt-6">
            <label for="qr-name" class="block text-sm font-semibold text-white">Name for the leaderboard</label>
            <input
              id="qr-name"
              name="name"
              type="text"
              maxlength="16"
              autocomplete="nickname"
              aria-describedby="qr-name-hint qr-name-error"
              class="mt-2 w-full rounded-lg border border-ink-400 bg-white px-3 py-2.5 text-ink-900"
            />
            <p id="qr-name-error" data-error-name role="alert" class="mt-1.5 text-sm font-semibold text-coral-300"></p>
            <p id="qr-name-hint" class="mt-1 text-sm text-ink-300">
              One spot per name, at its best score. The name is all we keep.
            </p>
            <p data-error-form role="alert" class="mt-2 text-sm font-semibold text-coral-300"></p>
            <div class="mt-5 flex flex-wrap gap-3">
              <button
                type="submit"
                class="rounded-xl bg-sunset-500 px-5 py-3 text-sm font-semibold text-ink-950 transition-colors hover:bg-sunset-600 disabled:opacity-70"
              >
                Save my score
              </button>
              <button
                type="button"
                data-play
                class="rounded-xl border border-ink-400 px-5 py-3 text-sm font-semibold text-white transition-colors hover:border-ink-200 hover:bg-white/5"
              >
                Play again
              </button>
            </div>
          </form>

          <div data-saved hidden class="mt-6">
            <h3 data-saved-title tabindex="-1" class="font-display text-xl font-semibold text-white focus:outline-none"></h3>
            <p data-saved-hint class="mt-1 text-sm text-ink-300"></p>
            <button
              type="button"
              data-play
              class="mt-5 rounded-xl bg-sunset-500 px-5 py-3 text-sm font-semibold text-ink-950 transition-colors hover:bg-sunset-600"
            >
              Play again
            </button>
          </div>
        </div>
      </div>

      <noscript>
        <div class="absolute inset-0 z-30 grid place-items-center bg-ink-950 p-6 text-center text-white">
          Quokka Run needs JavaScript switched on.
        </div>
      </noscript>
    </div>

    <div class="mt-12 grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-semibold text-white">How to play</h2>
        <ul class="mt-5 grid gap-3 leading-relaxed">
          <li>Tap, click or press Space to jump.</li>
          <li>Jump the hallucinations, GPU fires and 429 rate limits. Stay low under the flying ones.</li>
          <li>Grab tokens on the way for 20 points each.</li>
          <li>
            At each gate, jump through for <strong class="text-azure-300">FACT</strong> or run under for
            <strong class="text-coral-300">HALLUCINATION</strong>. Easy statements are worth 150, hard ones 400.
          </li>
          <li>It speeds up every 20 seconds, and new obstacles turn up.</li>
        </ul>
        <p class="mt-6 text-sm text-ink-300">
          Think one of the statements is wrong? <a
            href={`mailto:${site.email}?subject=Quokka%20Run%20statement`}
            class="font-medium text-azure-300 hover:underline">Tell us</a
          > and we'll fix it.
        </p>
      </div>

      <div class="rounded-2xl bg-ink-950/60 p-6 ring-1 ring-white/10">
        <h2 class="font-display text-2xl font-semibold text-white">Leaderboard</h2>
        <p class="mt-1 text-sm text-ink-300">The top 10, one spot per name.</p>
        <div data-board class="mt-5">
          <p class="text-ink-300">Loading…</p>
        </div>
      </div>
    </div>
  </Section>
</Base>

<script>
  import { startQuokkaRun } from '../scripts/quokka-run/game.js';

  const stage = document.querySelector<HTMLElement>('[data-quokka-run]');
  const board = document.querySelector<HTMLElement>('[data-board]');
  if (stage && board) startQuokkaRun(stage, board);
</script>

<style is:global>
  /* While running, a touch on the game is a jump: no scrolling, zooming or
     text selection. Outside a run the page scrolls as normal. */
  .qr-stage {
    -webkit-tap-highlight-color: transparent;
  }

  .qr-stage.is-playing {
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    cursor: pointer;
  }

  .qr-stage:focus {
    outline: none;
  }

  [data-gate-card][data-state='right'] [data-gate-meta] {
    color: var(--color-azure-700);
  }

  [data-gate-card][data-state='wrong'] [data-gate-meta] {
    color: var(--color-coral-700);
  }

  [data-gate-card]:not([data-state='question']) [data-gate-how] {
    display: none;
  }

  /* The level-up banner (added by game.js) */
  .qr-toast {
    position: absolute;
    left: 50%;
    top: 42%;
    z-index: 10;
    display: grid;
    justify-items: center;
    gap: 0.2em;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-weight: 700;
    color: white;
    text-align: center;
    text-shadow: 0 4px 0 rgb(0 0 0 / 0.4);
    pointer-events: none;
    animation: qr-toast 2.4s ease forwards;
  }

  .qr-toast strong {
    font-size: 2rem;
    color: var(--color-sunset-500);
  }

  .qr-toast span {
    font-size: 1.125rem;
  }

  @keyframes qr-toast {
    0% {
      opacity: 0;
      transform: translateX(-50%) scale(0.8);
    }
    12%,
    75% {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
    100% {
      opacity: 0;
      transform: translateX(-50%) translateY(-20px);
    }
  }

  /* No animation, but still on screen long enough to read (game.js removes it). */
  @media (prefers-reduced-motion: reduce) {
    .qr-toast {
      animation: none;
    }
  }
</style>
