---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import PixelSprite from '../components/PixelSprite.astro';
import site from '../data/site.json';

/* Quokka Run, the game from our DDD Perth 2026 booth, kept for good. The game
   needs client JavaScript (it's a canvas game) and the leaderboard needs the
   API at /api/quokka-run/scores. See docs/quokka-run.md.

   The markup for every screen is here; src/scripts/quokka-run/game.js only
   shows and hides it and fills in the numbers. */

const reportStatement = `mailto:${site.email}?subject=${encodeURIComponent('Quokka Run statement')}`;

const controlButton =
  'grid h-11 w-11 place-items-center rounded-xl bg-ink-950/70 text-white ring-1 ring-white/40 backdrop-blur-sm transition-colors hover:bg-ink-800';
const primaryButton =
  'inline-flex items-center justify-center gap-2 rounded-xl bg-sunset-500 px-5 py-3 text-sm font-semibold text-ink-950 transition-colors hover:bg-sunset-600 disabled:opacity-70';
const ghostButton =
  'inline-flex items-center justify-center gap-2 rounded-xl border border-ink-400 px-5 py-3 text-sm font-semibold text-white transition-colors hover:border-ink-200 hover:bg-white/5';

const legend = [
  { sprite: 'quokka', title: 'You', body: 'A quokka with somewhere to be.' },
  { sprite: 'bug', title: 'Hallucination', body: 'Jump it.' },
  { sprite: 'gpu', title: 'GPU fire', body: 'Jump it.' },
  { badge: '429', title: 'Rate limit', body: 'Jump it. Turns up at level 2.' },
  { sprite: 'drone', title: 'Flying hallucination', body: 'Don’t jump. Run under it. Level 4.' },
  { token: true, title: 'Token', body: '20 points each. Grab them mid-air.' },
] as const;

const keys = [
  ['Space', 'or', '↑', 'Jump'],
  ['P', 'or', 'Esc', 'Pause'],
  ['F', '', '', 'Full screen'],
  ['M', '', '', 'Sound on or off'],
];
---

<Base
  title="Quokka Run"
  description="A one-tap runner from Perth AI. Jump the hallucinations, dodge GPU fires and rate limits, tell fact from hallucination at every gate, and get on the leaderboard."
  image="/og-quokka-run.jpg"
  imageAlt="Quokka Run: a pixel-art quokka leaping in front of the Perth skyline"
>
  <div class="bg-ink-950 text-ink-100">
    {/* lg:pt-28 clears the header badge, as PageHero does. */}
    <div class="mx-auto max-w-6xl px-5 pb-12 pt-12 sm:px-8 sm:pt-16 lg:pt-28">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-azure-300">Perth AI arcade</p>
      <div class="mt-3 flex flex-wrap items-end justify-between gap-x-10 gap-y-3">
        <h1 class="font-display text-4xl font-semibold text-white sm:text-5xl">Quokka Run</h1>
        <p class="max-w-xl leading-relaxed text-ink-200/85 text-pretty">
          Jump the hallucinations, dodge the GPU fires, and tell fact from hallucination at every gate. It gets
          faster every 20 seconds.
        </p>
      </div>

      <div
        data-quokka-run
        tabindex="-1"
        role="region"
        aria-label="Quokka Run game"
        class="qr-stage relative isolate mt-8 h-[min(68svh,520px)] min-h-[420px] overflow-hidden rounded-2xl bg-gradient-to-b from-ink-800 to-ink-950 ring-1 ring-white/10 md:aspect-video md:h-auto md:max-h-[calc(100svh-7rem)] md:min-h-[360px]"
      >
        <img
          src="/perth-skyline.webp"
          alt=""
          aria-hidden="true"
          width="1600"
          height="579"
          class="pointer-events-none absolute inset-x-0 w-full opacity-25"
          style="bottom: var(--ground-px, 0)"
        />
        <canvas data-canvas aria-hidden="true" class="absolute inset-0 h-full w-full"></canvas>

        {/* What screen readers hear during a run: each statement, then the verdict. */}
        <p data-live class="sr-only" aria-live="polite"></p>

        {/* While running. The HUD is for sighted players; the result is announced at the end. */}
        <div
          data-hud
          hidden
          aria-hidden="true"
          class="qr-safe-top pointer-events-none absolute right-4 top-3 z-10 flex items-center gap-3 font-display text-sm font-bold text-white sm:gap-4 sm:text-base"
        >
          <span data-hud-level>Lv 1</span>
          <span data-hud-tokens>🪙 0</span>
          <span data-hud-gates>🧠 0/0</span>
          <span data-hud-score class="min-w-[4ch] text-right text-2xl tabular-nums text-sunset-500">0</span>
        </div>

        <div
          data-gate-card
          hidden
          aria-hidden="true"
          class="qr-gate pointer-events-none absolute inset-x-3 top-14 z-10 mx-auto max-w-3xl rounded-2xl bg-white px-5 py-4 text-center text-ink-900 shadow-[0_8px_0_rgb(0_0_0/0.35)] sm:px-8 sm:py-5"
        >
          <p data-gate-meta class="text-xs font-bold uppercase tracking-[0.12em] text-ink-600"></p>
          <p data-gate-text class="mt-1 font-display text-base font-semibold text-balance sm:text-xl"></p>
          <p data-gate-how class="mt-2 flex flex-wrap justify-center gap-x-6 gap-y-1 text-sm font-bold">
            <span class="text-azure-700">Jump through: FACT</span>
            <span class="text-coral-700">Run under: HALLUCINATION</span>
          </p>
        </div>

        <div
          data-countdown
          hidden
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 z-20 grid place-items-center font-display text-8xl font-bold text-white [text-shadow:0_6px_0_rgb(0_0_0/0.45)]"
        >
        </div>

        {/* Start screen, over the game playing itself */}
        <div
          data-start-screen
          class="absolute inset-0 z-20 flex flex-col items-center justify-center gap-4 bg-gradient-to-b from-ink-950/75 via-ink-950/45 to-ink-950/20 p-6 pb-20 text-center"
        >
          {/* Only shown in full screen, where the page's own heading is out of sight. */}
          <p data-start-title aria-hidden="true" class="hidden font-display text-5xl font-bold text-white sm:text-6xl">
            Quokka <span class="text-sunset-500">Run</span>
          </p>
          <p data-start-best hidden class="text-sm font-semibold text-sunbeam-400"></p>
          <button type="button" data-play class={`${primaryButton} px-8 py-4 font-display text-xl`}>
            <Icon name="play" class="h-5 w-5" />
            Start running
          </button>
          {/* Backplates, because tokens fly through this band of the demo behind. */}
          <p class="rounded-full bg-ink-950/70 px-3 py-1 text-sm font-medium text-ink-100">
            <span class="pointer-fine:hidden">Tap to start, then tap anywhere to jump.</span>
            <span class="hidden pointer-fine:inline">Space or ↑ to jump · P to pause · F for full screen</span>
          </p>
          <p class="hidden rounded-full bg-ink-950/70 px-3 py-1 text-sm font-semibold text-azure-300 max-sm:portrait:block">
            Turn your phone sideways to see further ahead.
          </p>
        </div>

        {/* Paused */}
        <div
          data-pause-screen
          hidden
          class="absolute inset-0 z-20 flex flex-col items-center justify-center gap-5 bg-ink-950/85 p-6 pb-20 text-center backdrop-blur-sm"
        >
          <h2 data-pause-heading tabindex="-1" class="font-display text-4xl font-semibold text-white focus:outline-none">
            Paused
          </h2>
          <div class="flex flex-wrap justify-center gap-3">
            <button type="button" data-resume class={primaryButton}>
              <Icon name="play" class="h-4 w-4" />
              Carry on
            </button>
            <button type="button" data-play class={ghostButton}>Start again</button>
          </div>
          <p class="hidden text-sm text-ink-300 pointer-fine:block">Press P or Space to carry on.</p>
        </div>

        {/* Results */}
        <div data-results hidden class="absolute inset-0 z-20 overflow-y-auto overscroll-contain bg-ink-950/85 backdrop-blur-sm">
          <div class="qr-results-grid mx-auto grid min-h-full max-w-4xl items-center gap-8 p-6 pb-20 md:px-10">
            <div>
              <h2
                data-results-heading
                tabindex="-1"
                class="text-sm font-semibold uppercase tracking-[0.14em] text-azure-300 focus:outline-none"
              >
                <span data-cause>Game over</span>
                <span class="sr-only">. You scored</span>
                <span data-final class="mt-2 block font-display text-6xl normal-case tracking-tight text-sunset-500 tabular-nums">
                  0
                </span>
              </h2>
              <p data-summary class="mt-3 text-ink-200"></p>
              <p data-best class="mt-2 text-sm font-semibold text-sunbeam-400"></p>

              <form data-save novalidate class="mt-6">
                <label for="qr-name" class="block text-sm font-semibold text-white">Name for the leaderboard</label>
                <input
                  id="qr-name"
                  name="name"
                  type="text"
                  maxlength="16"
                  autocomplete="nickname"
                  enterkeyhint="done"
                  aria-describedby="qr-name-error qr-name-hint"
                  class="mt-2 w-full rounded-lg border border-ink-400 bg-white px-3 py-2.5 text-base text-ink-900"
                />
                <p id="qr-name-error" data-error-name class="mt-1.5 text-sm font-semibold text-coral-300"></p>
                <p id="qr-name-hint" class="mt-1 text-sm text-ink-300">
                  One spot per name, at its best score. We keep the name and the score, nothing else.
                </p>
                <p data-error-form role="alert" class="mt-2 text-sm font-semibold text-coral-300"></p>
                <div class="mt-5 flex flex-wrap gap-3">
                  <button type="submit" class={primaryButton}>Save my score</button>
                  <button type="button" data-play class={ghostButton}>Play again</button>
                  <button type="button" data-share class={ghostButton}>
                    <Icon name="share" class="h-4 w-4" />
                    Share
                  </button>
                </div>
              </form>

              <div data-saved hidden class="mt-6">
                <h3 data-saved-title tabindex="-1" class="font-display text-xl font-semibold text-white focus:outline-none"></h3>
                <p data-saved-hint class="mt-1 text-sm text-ink-300"></p>
                <div class="mt-5 flex flex-wrap gap-3">
                  <button type="button" data-play class={primaryButton}>
                    <Icon name="play" class="h-4 w-4" />
                    Play again
                  </button>
                  <button type="button" data-share class={ghostButton}>
                    <Icon name="share" class="h-4 w-4" />
                    Share score
                  </button>
                </div>
              </div>
            </div>

            {/* The board, beside the result when there's room (always in full screen). */}
            <div class="qr-results-board rounded-2xl bg-white/5 p-4 ring-1 ring-white/10">
              <h3 class="font-display text-lg font-semibold text-white">Leaderboard</h3>
              <div data-board-list data-compact class="mt-3"></div>
            </div>
          </div>
        </div>

        {/* Always on top: pause (while running), sound and full screen. */}
        <div data-controls class="qr-safe-bottom absolute bottom-3 right-3 z-30 flex gap-2">
          <button type="button" data-pause hidden class={controlButton} aria-label="Pause" title="Pause (P)">
            <Icon name="pause" class="h-5 w-5" />
          </button>
          <button type="button" data-sound class={`group ${controlButton}`} aria-pressed="true" title="Sound (M)">
            <span class="sr-only">Sound</span>
            <Icon name="sound" class="h-5 w-5 group-aria-[pressed=false]:hidden" />
            <Icon name="mute" class="hidden h-5 w-5 group-aria-[pressed=false]:block" />
          </button>
          <button type="button" data-fullscreen class={`group ${controlButton}`} aria-pressed="false" title="Full screen (F)">
            <span class="sr-only">Full screen</span>
            <Icon name="expand" class="h-5 w-5 group-aria-pressed:hidden" />
            <Icon name="collapse" class="hidden h-5 w-5 group-aria-pressed:block" />
          </button>
        </div>

        <p
          data-notice
          role="status"
          class="pointer-events-none absolute bottom-16 left-1/2 z-40 w-max max-w-[calc(100%-2rem)] -translate-x-1/2 rounded-full bg-white px-4 py-2 text-center text-sm font-semibold text-balance text-ink-900 opacity-0 transition-opacity data-[show]:opacity-100"
        >
        </p>

        <noscript>
          <div class="absolute inset-0 z-50 grid place-items-center bg-ink-950 p-6 text-center text-white">
            Quokka Run needs JavaScript switched on.
          </div>
        </noscript>
      </div>
    </div>
  </div>

  <Section tone="dark">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)]">
      <div>
        <h2 class="font-display text-3xl font-semibold text-white">How to play</h2>
        <p class="mt-3 max-w-xl leading-relaxed text-ink-200/85">
          Tap, click or press Space to jump. Every so often a statement pops up and a gate rolls in: jump through
          the top for <strong class="text-azure-300">FACT</strong>, or run under it for{' '}
          <strong class="text-coral-300">HALLUCINATION</strong>. Gates are worth 150, 250 or 400, depending on how
          hard the statement is.
        </p>

        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {
            legend.map((item) => (
              <li class="flex items-center gap-4 rounded-xl bg-white/5 p-4 ring-1 ring-white/10">
                <span class="grid h-12 w-14 shrink-0 place-items-center">
                  {'sprite' in item && <PixelSprite name={item.sprite} class="h-12 w-auto" />}
                  {'badge' in item && (
                    <span
                      aria-hidden="true"
                      class="rounded-sm bg-coral-500 px-1.5 py-0.5 font-display text-sm font-bold text-ink-950 ring-2 ring-coral-700"
                    >
                      {item.badge}
                    </span>
                  )}
                  {'token' in item && (
                    <span
                      aria-hidden="true"
                      class="grid h-7 w-7 place-items-center rounded-full bg-sunset-300 font-display text-xs font-bold text-ink-900 ring-[3px] ring-sunset-600"
                    >
                      T
                    </span>
                  )}
                </span>
                <span>
                  <strong class="block font-display text-white">{item.title}</strong>
                  <span class="text-sm text-ink-300">{item.body}</span>
                </span>
              </li>
            ))
          }
        </ul>

        <h3 class="mt-10 font-display text-lg font-semibold text-white">On a keyboard</h3>
        <dl class="mt-4 grid max-w-md grid-cols-[auto_1fr] gap-x-6 gap-y-2.5 text-sm">
          {
            keys.map(([a, joiner, b, action]) => (
              <>
                <dt class="flex items-center gap-1.5 text-ink-300">
                  <kbd class="rounded-md bg-white/10 px-2 py-0.5 font-sans font-semibold text-white ring-1 ring-white/15">
                    {a}
                  </kbd>
                  {joiner && <span>{joiner}</span>}
                  {b && (
                    <kbd class="rounded-md bg-white/10 px-2 py-0.5 font-sans font-semibold text-white ring-1 ring-white/15">
                      {b}
                    </kbd>
                  )}
                </dt>
                <dd class="self-center text-ink-200">{action}</dd>
              </>
            ))
          }
        </dl>
      </div>

      <div class="self-start rounded-2xl bg-ink-950/60 p-6 ring-1 ring-white/10 lg:sticky lg:top-28">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="font-display text-2xl font-semibold text-white">Leaderboard</h2>
          <p class="text-sm text-ink-300">One spot per name</p>
        </div>
        <div data-board-list class="mt-5">
          <ol class="grid gap-1.5" aria-hidden="true">
            {Array.from({ length: 5 }, () => <li class="h-10 animate-pulse rounded-lg bg-white/5" />)}
          </ol>
          <p class="sr-only">Loading the leaderboard.</p>
        </div>
        <noscript><p class="mt-3 text-ink-300">The leaderboard needs JavaScript switched on.</p></noscript>
      </div>
    </div>
  </Section>

  <Section
    eyebrow="Where it came from"
    title="Built for a conference booth"
    lead="We made Quokka Run for the Perth AI booth at DDD Perth 2026. It's a quick way into the thing everyone working with AI deals with daily: telling what's true from what only sounds true. The statements are about AI, computing and Perth."
  >
    <div class="flex flex-col gap-3 sm:flex-row">
      <Button href="/events" variant="primary">
        Come to an event
        <Icon name="arrow" class="h-4 w-4" />
      </Button>
      <Button href={reportStatement} variant="ghost">Report a wrong statement</Button>
    </div>
  </Section>
</Base>

<script>
  import { startQuokkaRun } from '../scripts/quokka-run/game.js';

  const stage = document.querySelector<HTMLElement>('[data-quokka-run]');
  if (stage) startQuokkaRun(stage);
</script>

<style is:global>
  .qr-stage {
    -webkit-tap-highlight-color: transparent;
  }

  /* While running, a touch on the game is a jump: no scrolling, zooming or
     text selection. Outside a run the page scrolls as normal. */
  .qr-stage.is-playing {
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    cursor: pointer;
  }

  .qr-stage:focus {
    outline: none;
  }

  /* Full screen. The browser's own full screen sizes the stage already; on
     iPhones (no element full screen) this alone makes it fill the window. */
  .qr-stage.is-fullscreen {
    position: fixed !important;
    inset: 0 !important;
    z-index: 100;
    width: 100% !important;
    height: 100% !important;
    max-height: none !important;
    min-height: 0 !important;
    aspect-ratio: auto !important;
    margin: 0 !important;
    border-radius: 0 !important;
    touch-action: none;
  }

  /* The page behind the iPhone fallback doesn't scroll. */
  html.qr-locked,
  html.qr-locked body {
    overflow: hidden;
    overscroll-behavior: none;
  }

  .qr-stage.is-fullscreen [data-start-title] {
    display: block;
  }

  /* Keep the HUD and buttons clear of notches and rounded corners. */
  .qr-stage.is-fullscreen .qr-safe-top {
    top: max(0.75rem, env(safe-area-inset-top));
    right: max(1rem, env(safe-area-inset-right));
  }

  .qr-stage.is-fullscreen .qr-safe-bottom {
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    right: max(0.75rem, env(safe-area-inset-right));
  }

  /* Results: the board sits beside the score on wide screens and below it in
     full screen. Elsewhere the page's own board is just below the game. */
  .qr-results-board {
    display: none;
  }

  @media (min-width: 1024px) {
    .qr-results-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 18rem);
    }
    .qr-results-board {
      display: block;
    }
  }

  /* In full screen the page's board is out of reach, so this one always shows. */
  .qr-stage.is-fullscreen .qr-results-board {
    display: block;
  }

  @media (min-width: 640px) and (orientation: landscape) {
    .qr-stage.is-fullscreen .qr-results-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 18rem);
    }
  }

  /* Phones on their side have very little height: a slimmer statement card so
     it doesn't sit over the gate. */
  @media (max-height: 500px) {
    .qr-stage .qr-gate {
      top: 2.75rem;
      padding: 0.5rem 1rem;
      box-shadow: 0 5px 0 rgb(0 0 0 / 0.35);
    }
    .qr-stage .qr-gate [data-gate-text] {
      font-size: 0.95rem;
    }
    .qr-stage .qr-gate [data-gate-how] {
      margin-top: 0.25rem;
      font-size: 0.75rem;
    }
  }

  [data-gate-card][data-state='right'] [data-gate-meta] {
    color: var(--color-azure-700);
  }

  [data-gate-card][data-state='wrong'] [data-gate-meta] {
    color: var(--color-coral-700);
  }

  [data-gate-card]:not([data-state='question']) [data-gate-how] {
    display: none;
  }

  /* The level-up banner (added by game.js) */
  .qr-toast {
    position: absolute;
    left: 50%;
    top: 42%;
    z-index: 15;
    display: grid;
    padding: 0.5rem 1rem;
    border-radius: 1rem;
    background: rgb(5 10 23 / 0.8);
    justify-items: center;
    gap: 0.2em;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-weight: 700;
    color: white;
    text-align: center;
    text-shadow: 0 4px 0 rgb(0 0 0 / 0.4);
    pointer-events: none;
    animation: qr-toast 2.4s ease forwards;
  }

  .qr-toast strong {
    font-size: 2rem;
    color: var(--color-sunset-500);
  }

  .qr-toast span {
    font-size: 1.125rem;
  }

  @keyframes qr-toast {
    0% {
      opacity: 0;
      transform: translateX(-50%) scale(0.8);
    }
    12%,
    75% {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
    100% {
      opacity: 0;
      transform: translateX(-50%) translateY(-20px);
    }
  }

  [data-countdown]:not([hidden]) {
    animation: qr-count 0.45s ease-out infinite;
  }

  @keyframes qr-count {
    from {
      transform: scale(1.4);
      opacity: 0.3;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  /* No animation, but still on screen long enough to read (game.js removes it). */
  @media (prefers-reduced-motion: reduce) {
    .qr-toast,
    [data-countdown]:not([hidden]) {
      animation: none;
    }
  }
</style>
