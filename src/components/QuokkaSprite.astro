---
/* The Quokka Run quokka, mid-jump, as an SVG drawn at build time from the
   game's own pixel map (src/scripts/quokka-run/sprites.js). No image file and
   no client JavaScript. Decorative, so it's hidden from screen readers. */
import { PALETTE, QUOKKA_JUMP } from '../scripts/quokka-run/sprites.js';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const palette: Record<string, string> = PALETTE;
const width = Math.max(...QUOKKA_JUMP.map((row) => row.length));
const pixels = QUOKKA_JUMP.flatMap((row, y) =>
  [...row].flatMap((ch, x) => (palette[ch] ? [{ x, y, fill: palette[ch] }] : []))
);
---

<svg
  viewBox={`0 0 ${width} ${QUOKKA_JUMP.length}`}
  class={className}
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  {pixels.map((p) => <rect x={p.x} y={p.y} width="1" height="1" fill={p.fill} />)}
</svg>
