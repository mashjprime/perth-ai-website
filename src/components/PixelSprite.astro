---
/* A Quokka Run sprite as an SVG, drawn at build time from the game's own
   pixel maps (src/scripts/quokka-run/sprites.js). No image file and no client
   JavaScript. Decorative, so it's hidden from screen readers: say what it is
   in the text beside it. */
import { PALETTE, SPRITE_ROWS } from '../scripts/quokka-run/sprites.js';

interface Props {
  name: keyof typeof SPRITE_ROWS;
  class?: string;
}

const { name, class: className = '' } = Astro.props;
const palette: Record<string, string> = PALETTE;
const rows: string[] = SPRITE_ROWS[name];
const width = Math.max(...rows.map((row) => row.length));
const pixels = rows.flatMap((row, y) => [...row].flatMap((ch, x) => (palette[ch] ? [{ x, y, fill: palette[ch] }] : [])));
---

<svg
  viewBox={`0 0 ${width} ${rows.length}`}
  class={className}
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  {pixels.map((p) => <rect x={p.x} y={p.y} width="1" height="1" fill={p.fill} />)}
</svg>
